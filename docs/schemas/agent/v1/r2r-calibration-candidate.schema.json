{
  "$defs": {
    "SchemaVersion": {
      "description": "Version of the transport-neutral HHTools agent schema.",
      "enum": [
        "1.0"
      ],
      "title": "SchemaVersion",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Content-bound target pose for one exact source/target robot pair.",
  "properties": {
    "algorithm": {
      "const": "hhtools.r2r-calibration.kinematic.v1",
      "default": "hhtools.r2r-calibration.kinematic.v1",
      "title": "Algorithm",
      "type": "string"
    },
    "baseline": {
      "enum": [
        "urdf_zero",
        "saved_calibration",
        "candidate"
      ],
      "title": "Baseline",
      "type": "string"
    },
    "baseline_calibration_id": {
      "anyOf": [
        {
          "description": "Content-addressed calibration id.",
          "pattern": "^cal:sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Baseline Calibration Id"
    },
    "candidate_id": {
      "description": "Content-addressed immutable calibration candidate id.",
      "pattern": "^cal-candidate:sha256:[0-9a-f]{64}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "joint_q": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Joint Q",
      "type": "object"
    },
    "locked_joints": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 512,
      "title": "Locked Joints",
      "type": "array"
    },
    "parent_candidate_id": {
      "anyOf": [
        {
          "description": "Content-addressed immutable calibration candidate id.",
          "pattern": "^cal-candidate:sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Candidate Id"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion",
      "default": "1.0"
    },
    "source_robot_asset_id": {
      "description": "Content-addressed asset id.",
      "pattern": "^asset:sha256:[0-9a-f]{64}$",
      "title": "Source Robot Asset Id",
      "type": "string"
    },
    "source_robot_digest": {
      "description": "Lower-case SHA-256 content digest.",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Robot Digest",
      "type": "string"
    },
    "source_robot_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Source Robot Id",
      "type": "string"
    },
    "target_robot_asset_id": {
      "description": "Content-addressed asset id.",
      "pattern": "^asset:sha256:[0-9a-f]{64}$",
      "title": "Target Robot Asset Id",
      "type": "string"
    },
    "target_robot_digest": {
      "description": "Lower-case SHA-256 content digest.",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Target Robot Digest",
      "type": "string"
    },
    "target_robot_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Target Robot Id",
      "type": "string"
    },
    "workflow": {
      "const": "r2r",
      "default": "r2r",
      "title": "Workflow",
      "type": "string"
    }
  },
  "required": [
    "candidate_id",
    "source_robot_id",
    "source_robot_asset_id",
    "source_robot_digest",
    "target_robot_id",
    "target_robot_asset_id",
    "target_robot_digest",
    "baseline",
    "joint_q"
  ],
  "title": "R2RCalibrationCandidate",
  "type": "object"
}
