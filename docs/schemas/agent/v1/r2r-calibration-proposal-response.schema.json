{
  "$defs": {
    "CalibrationValidationReport": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "anyOf": [
            {
              "description": "Content-addressed immutable calibration candidate id.",
              "pattern": "^cal-candidate:sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Id"
        },
        "changed_joint_count": {
          "minimum": 0,
          "title": "Changed Joint Count",
          "type": "integer"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/PreflightCheck"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Checks",
          "type": "array"
        },
        "edge_errors_deg": {
          "additionalProperties": {
            "type": "number"
          },
          "maxProperties": 32,
          "title": "Edge Errors Deg",
          "type": "object"
        },
        "mapped_slots": {
          "maximum": 17,
          "minimum": 0,
          "title": "Mapped Slots",
          "type": "integer"
        },
        "near_limit_joints": {
          "items": {
            "type": "string"
          },
          "maxItems": 512,
          "title": "Near Limit Joints",
          "type": "array"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "valid": {
          "title": "Valid",
          "type": "boolean"
        }
      },
      "required": [
        "valid",
        "score",
        "changed_joint_count",
        "mapped_slots",
        "checks"
      ],
      "title": "CalibrationValidationReport",
      "type": "object"
    },
    "NextAction": {
      "additionalProperties": false,
      "description": "An explicit recovery or continuation step for an agent or human.",
      "properties": {
        "action": {
          "description": "Stable, English action identifier.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Action",
          "type": "string"
        },
        "actor": {
          "enum": [
            "agent",
            "human",
            "system"
          ],
          "title": "Actor",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional human-readable instruction.",
          "title": "Message"
        },
        "parameters": {
          "additionalProperties": true,
          "description": "Structured parameters needed to perform the action.",
          "title": "Parameters",
          "type": "object"
        },
        "url": {
          "anyOf": [
            {
              "pattern": "^(?:(?:/(?:\\?(?:(?:calibrate|panel|robot|view)=[^&#\\s]{0,256}(?:&(?:calibrate|panel|robot|view)=[^&#\\s]{0,256})*)?)?|http://(?:127\\.0\\.0\\.1|localhost|\\[::1\\]):(?:0|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])/(?:\\?(?:(?:calibrate|panel|robot|view)=[^&#\\s]{0,256}(?:&(?:calibrate|panel|robot|view)=[^&#\\s]{0,256})*)?)?)|https://(?:\\[(?:(?:(?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,7}:|(?:[0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,5}(?::[0-9A-Fa-f]{1,4}){1,2}|(?:[0-9A-Fa-f]{1,4}:){1,4}(?::[0-9A-Fa-f]{1,4}){1,3}|(?:[0-9A-Fa-f]{1,4}:){1,3}(?::[0-9A-Fa-f]{1,4}){1,4}|(?:[0-9A-Fa-f]{1,4}:){1,2}(?::[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:(?:(?::[0-9A-Fa-f]{1,4}){1,6})|:(?:(?::[0-9A-Fa-f]{1,4}){1,7}|:)))\\]|[A-Za-z0-9._~-]+)(?::(?:0|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:[/?#](?:(?:[A-Za-z0-9._~!$&'()*+,;=:@-]|%[0-9A-Fa-f]{2})|[/?#])*)?)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional allowlisted local calibration UI route or portable HTTPS documentation URL.",
          "title": "Url"
        }
      },
      "required": [
        "actor",
        "action"
      ],
      "title": "NextAction",
      "type": "object"
    },
    "PreflightCheck": {
      "additionalProperties": false,
      "description": "One deterministic precondition evaluated by the service.",
      "properties": {
        "code": {
          "description": "Stable, English, machine-readable code.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "level": {
          "$ref": "#/$defs/PreflightCheckLevel"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "next_action": {
          "anyOf": [
            {
              "$ref": "#/$defs/NextAction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "code",
        "level",
        "message"
      ],
      "title": "PreflightCheck",
      "type": "object"
    },
    "PreflightCheckLevel": {
      "enum": [
        "pass",
        "warning",
        "error"
      ],
      "title": "PreflightCheckLevel",
      "type": "string"
    },
    "R2RCalibrationCandidate": {
      "additionalProperties": false,
      "description": "Content-bound target pose for one exact source/target robot pair.",
      "properties": {
        "algorithm": {
          "const": "hhtools.r2r-calibration.kinematic.v1",
          "default": "hhtools.r2r-calibration.kinematic.v1",
          "title": "Algorithm",
          "type": "string"
        },
        "baseline": {
          "enum": [
            "urdf_zero",
            "saved_calibration",
            "candidate"
          ],
          "title": "Baseline",
          "type": "string"
        },
        "baseline_calibration_id": {
          "anyOf": [
            {
              "description": "Content-addressed calibration id.",
              "pattern": "^cal:sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Calibration Id"
        },
        "candidate_id": {
          "description": "Content-addressed immutable calibration candidate id.",
          "pattern": "^cal-candidate:sha256:[0-9a-f]{64}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "joint_q": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Joint Q",
          "type": "object"
        },
        "locked_joints": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 512,
          "title": "Locked Joints",
          "type": "array"
        },
        "parent_candidate_id": {
          "anyOf": [
            {
              "description": "Content-addressed immutable calibration candidate id.",
              "pattern": "^cal-candidate:sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Candidate Id"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "source_robot_asset_id": {
          "description": "Content-addressed asset id.",
          "pattern": "^asset:sha256:[0-9a-f]{64}$",
          "title": "Source Robot Asset Id",
          "type": "string"
        },
        "source_robot_digest": {
          "description": "Lower-case SHA-256 content digest.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Robot Digest",
          "type": "string"
        },
        "source_robot_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Source Robot Id",
          "type": "string"
        },
        "target_robot_asset_id": {
          "description": "Content-addressed asset id.",
          "pattern": "^asset:sha256:[0-9a-f]{64}$",
          "title": "Target Robot Asset Id",
          "type": "string"
        },
        "target_robot_digest": {
          "description": "Lower-case SHA-256 content digest.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Target Robot Digest",
          "type": "string"
        },
        "target_robot_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Target Robot Id",
          "type": "string"
        },
        "workflow": {
          "const": "r2r",
          "default": "r2r",
          "title": "Workflow",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "source_robot_id",
        "source_robot_asset_id",
        "source_robot_digest",
        "target_robot_id",
        "target_robot_asset_id",
        "target_robot_digest",
        "baseline",
        "joint_q"
      ],
      "title": "R2RCalibrationCandidate",
      "type": "object"
    },
    "SchemaVersion": {
      "description": "Version of the transport-neutral HHTools agent schema.",
      "enum": [
        "1.0"
      ],
      "title": "SchemaVersion",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate": {
      "$ref": "#/$defs/R2RCalibrationCandidate"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion",
      "default": "1.0"
    },
    "validation": {
      "$ref": "#/$defs/CalibrationValidationReport"
    }
  },
  "required": [
    "candidate",
    "validation"
  ],
  "title": "R2RCalibrationProposalResponse",
  "type": "object"
}
