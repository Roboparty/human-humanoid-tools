{
  "$defs": {
    "OutputPolicy": {
      "enum": [
        "create_new",
        "fail_if_exists",
        "overwrite"
      ],
      "title": "OutputPolicy",
      "type": "string"
    },
    "SchemaVersion": {
      "description": "Version of the transport-neutral HHTools agent schema.",
      "enum": [
        "1.0"
      ],
      "title": "SchemaVersion",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Resolved R2R plan binding one trajectory, two robots, and pair calibration.",
  "properties": {
    "backend": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Backend",
      "type": "string"
    },
    "calibration_digest": {
      "description": "Lower-case SHA-256 content digest.",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Calibration Digest",
      "type": "string"
    },
    "calibration_id": {
      "description": "Content-addressed calibration id.",
      "pattern": "^cal:sha256:[0-9a-f]{64}$",
      "title": "Calibration Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "output_format": {
      "maxLength": 32,
      "minLength": 1,
      "title": "Output Format",
      "type": "string"
    },
    "output_policy": {
      "$ref": "#/$defs/OutputPolicy"
    },
    "parameters": {
      "additionalProperties": true,
      "title": "Parameters",
      "type": "object"
    },
    "plan_id": {
      "description": "Content-addressed plan id.",
      "pattern": "^plan:sha256:[0-9a-f]{64}$",
      "title": "Plan Id",
      "type": "string"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion",
      "default": "1.0"
    },
    "source_robot_asset_id": {
      "description": "Content-addressed asset id.",
      "pattern": "^asset:sha256:[0-9a-f]{64}$",
      "title": "Source Robot Asset Id",
      "type": "string"
    },
    "source_robot_digest": {
      "description": "Lower-case SHA-256 content digest.",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Robot Digest",
      "type": "string"
    },
    "source_robot_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Source Robot Id",
      "type": "string"
    },
    "target_robot_asset_id": {
      "description": "Content-addressed asset id.",
      "pattern": "^asset:sha256:[0-9a-f]{64}$",
      "title": "Target Robot Asset Id",
      "type": "string"
    },
    "target_robot_digest": {
      "description": "Lower-case SHA-256 content digest.",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Target Robot Digest",
      "type": "string"
    },
    "target_robot_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Target Robot Id",
      "type": "string"
    },
    "trajectory_asset_id": {
      "description": "Content-addressed asset id.",
      "pattern": "^asset:sha256:[0-9a-f]{64}$",
      "title": "Trajectory Asset Id",
      "type": "string"
    },
    "trajectory_digest": {
      "description": "Lower-case SHA-256 content digest.",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Trajectory Digest",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "created_at",
    "trajectory_asset_id",
    "source_robot_id",
    "source_robot_asset_id",
    "target_robot_id",
    "target_robot_asset_id",
    "backend",
    "calibration_id",
    "output_format",
    "output_policy",
    "trajectory_digest",
    "source_robot_digest",
    "target_robot_digest",
    "calibration_digest"
  ],
  "title": "R2RPlan",
  "type": "object"
}
