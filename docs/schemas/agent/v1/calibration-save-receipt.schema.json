{
  "$defs": {
    "CalibrationReference": {
      "enum": [
        "smplx",
        "smpl",
        "gvhmr",
        "soma_bvh",
        "lafan_bvh",
        "mocap_bvh",
        "xsens_mocap",
        "glb"
      ],
      "title": "CalibrationReference",
      "type": "string"
    },
    "CalibrationValidationReport": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "anyOf": [
            {
              "description": "Content-addressed immutable calibration candidate id.",
              "pattern": "^cal-candidate:sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Id"
        },
        "changed_joint_count": {
          "minimum": 0,
          "title": "Changed Joint Count",
          "type": "integer"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/PreflightCheck"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Checks",
          "type": "array"
        },
        "edge_errors_deg": {
          "additionalProperties": {
            "type": "number"
          },
          "maxProperties": 32,
          "title": "Edge Errors Deg",
          "type": "object"
        },
        "mapped_slots": {
          "maximum": 17,
          "minimum": 0,
          "title": "Mapped Slots",
          "type": "integer"
        },
        "near_limit_joints": {
          "items": {
            "type": "string"
          },
          "maxItems": 512,
          "title": "Near Limit Joints",
          "type": "array"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "1.0"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "valid": {
          "title": "Valid",
          "type": "boolean"
        }
      },
      "required": [
        "valid",
        "score",
        "changed_joint_count",
        "mapped_slots",
        "checks"
      ],
      "title": "CalibrationValidationReport",
      "type": "object"
    },
    "CalibrationVisualReview": {
      "additionalProperties": false,
      "properties": {
        "model_hint": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Hint"
        },
        "observations": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Observations",
          "type": "array"
        },
        "reviewer": {
          "enum": [
            "gpt_vision",
            "human"
          ],
          "title": "Reviewer",
          "type": "string"
        },
        "summary": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/CalibrationVisualVerdict"
        }
      },
      "required": [
        "reviewer",
        "verdict",
        "summary"
      ],
      "title": "CalibrationVisualReview",
      "type": "object"
    },
    "CalibrationVisualVerdict": {
      "enum": [
        "pass",
        "adjust",
        "reject"
      ],
      "title": "CalibrationVisualVerdict",
      "type": "string"
    },
    "NextAction": {
      "additionalProperties": false,
      "description": "An explicit recovery or continuation step for an agent or human.",
      "properties": {
        "action": {
          "description": "Stable, English action identifier.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Action",
          "type": "string"
        },
        "actor": {
          "enum": [
            "agent",
            "human",
            "system"
          ],
          "title": "Actor",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional human-readable instruction.",
          "title": "Message"
        },
        "parameters": {
          "additionalProperties": true,
          "description": "Structured parameters needed to perform the action.",
          "title": "Parameters",
          "type": "object"
        },
        "url": {
          "anyOf": [
            {
              "pattern": "^(?:(?:/(?:\\?(?:(?:calibrate|panel|robot|view)=[^&#\\s]{0,256}(?:&(?:calibrate|panel|robot|view)=[^&#\\s]{0,256})*)?)?|http://(?:127\\.0\\.0\\.1|localhost|\\[::1\\]):(?:0|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])/(?:\\?(?:(?:calibrate|panel|robot|view)=[^&#\\s]{0,256}(?:&(?:calibrate|panel|robot|view)=[^&#\\s]{0,256})*)?)?)|https://(?:\\[(?:(?:(?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,7}:|(?:[0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,5}(?::[0-9A-Fa-f]{1,4}){1,2}|(?:[0-9A-Fa-f]{1,4}:){1,4}(?::[0-9A-Fa-f]{1,4}){1,3}|(?:[0-9A-Fa-f]{1,4}:){1,3}(?::[0-9A-Fa-f]{1,4}){1,4}|(?:[0-9A-Fa-f]{1,4}:){1,2}(?::[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:(?:(?::[0-9A-Fa-f]{1,4}){1,6})|:(?:(?::[0-9A-Fa-f]{1,4}){1,7}|:)))\\]|[A-Za-z0-9._~-]+)(?::(?:0|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:[/?#](?:(?:[A-Za-z0-9._~!$&'()*+,;=:@-]|%[0-9A-Fa-f]{2})|[/?#])*)?)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional allowlisted local calibration UI route or portable HTTPS documentation URL.",
          "title": "Url"
        }
      },
      "required": [
        "actor",
        "action"
      ],
      "title": "NextAction",
      "type": "object"
    },
    "PreflightCheck": {
      "additionalProperties": false,
      "description": "One deterministic precondition evaluated by the service.",
      "properties": {
        "code": {
          "description": "Stable, English, machine-readable code.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "level": {
          "$ref": "#/$defs/PreflightCheckLevel"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "next_action": {
          "anyOf": [
            {
              "$ref": "#/$defs/NextAction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "code",
        "level",
        "message"
      ],
      "title": "PreflightCheck",
      "type": "object"
    },
    "PreflightCheckLevel": {
      "enum": [
        "pass",
        "warning",
        "error"
      ],
      "title": "PreflightCheckLevel",
      "type": "string"
    },
    "SchemaVersion": {
      "description": "Version of the transport-neutral HHTools agent schema.",
      "enum": [
        "1.0"
      ],
      "title": "SchemaVersion",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "calibration_digest": {
      "description": "Lower-case SHA-256 content digest.",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Calibration Digest",
      "type": "string"
    },
    "calibration_id": {
      "description": "Content-addressed calibration id.",
      "pattern": "^cal:sha256:[0-9a-f]{64}$",
      "title": "Calibration Id",
      "type": "string"
    },
    "candidate_id": {
      "description": "Content-addressed immutable calibration candidate id.",
      "pattern": "^cal-candidate:sha256:[0-9a-f]{64}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "previous_calibration_archived": {
      "default": false,
      "title": "Previous Calibration Archived",
      "type": "boolean"
    },
    "previous_calibration_id": {
      "anyOf": [
        {
          "description": "Content-addressed calibration id.",
          "pattern": "^cal:sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Calibration Id"
    },
    "reference": {
      "$ref": "#/$defs/CalibrationReference"
    },
    "robot_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Robot Id",
      "type": "string"
    },
    "save_mode": {
      "enum": [
        "validated_silent",
        "gpt_vision_silent"
      ],
      "title": "Save Mode",
      "type": "string"
    },
    "saved": {
      "const": true,
      "default": true,
      "title": "Saved",
      "type": "boolean"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion",
      "default": "1.0"
    },
    "validation": {
      "$ref": "#/$defs/CalibrationValidationReport"
    },
    "visual_review": {
      "anyOf": [
        {
          "$ref": "#/$defs/CalibrationVisualReview"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "candidate_id",
    "calibration_id",
    "calibration_digest",
    "robot_id",
    "reference",
    "save_mode",
    "validation"
  ],
  "title": "CalibrationSaveReceipt",
  "type": "object"
}
